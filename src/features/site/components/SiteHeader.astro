---
import { profile } from "../../../content/profile";

/** Fixed top bar. The active section gets the red indicator (set by site motion). */
const sections = [
  { id: "about", label: "About" },
  { id: "work", label: "Work" },
  { id: "contact", label: "Contact" },
] as const;
---

<header class="site-header" data-header>
  <a href="#top" class="font-display text-base font-semibold text-text no-underline">
    {profile.name}
  </a>
  <nav aria-label="Primary">
    <ul class="flex items-center gap-1 sm:gap-6">
      {sections.map((s) => (
        <li class="max-sm:hidden">
          <a href={`#${s.id}`} class="nav-link" data-nav={s.id}>
            {s.label}
          </a>
        </li>
      ))}
      <li>
        <a href={profile.links.cv.href} class="nav-link">
          CV
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    transition:
      background-color 400ms var(--ease-out-expo),
      border-color 400ms;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-solid] {
    background: rgb(3 10 16 / 0.92);
    border-color: var(--color-line);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 200ms;
  }
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--color-text);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.45rem;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease-out-expo);
  }
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }
</style>
