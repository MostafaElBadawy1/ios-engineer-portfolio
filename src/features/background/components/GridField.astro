---
/**
 * Fixed, decorative background: a fine line grid that bends around the cursor
 * and drifts with scroll, over two slow atmospheric lights that change per section.
 */
---

<div class="atmosphere" aria-hidden="true" data-atmosphere></div>
<canvas class="grid-field" aria-hidden="true" data-grid></canvas>

<style>
  .atmosphere,
  .grid-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .atmosphere {
    z-index: -2;
    --steel-x: 18%;
    --steel-y: 0%;
    --steel-a: 0.1;
    --crimson-x: 86%;
    --crimson-y: 100%;
    --crimson-a: 0.16;
    background:
      radial-gradient(60% 55% at var(--steel-x) var(--steel-y), rgb(102 155 188 / var(--steel-a)), transparent 70%),
      radial-gradient(55% 50% at var(--crimson-x) var(--crimson-y), rgb(120 0 0 / var(--crimson-a)), transparent 72%);
  }
  .grid-field {
    z-index: -1;
    -webkit-mask: radial-gradient(130% 95% at 50% 40%, #000 45%, transparent 100%);
    mask: radial-gradient(130% 95% at 50% 40%, #000 45%, transparent 100%);
  }
</style>

<script>
  import { startGrid } from "../utils/grid-controller";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-grid]");
  const start = (): void => {
    if (!canvas) return;
    startGrid(canvas, {
      reducedMotion: matchMedia("(prefers-reduced-motion: reduce)").matches,
      finePointer: matchMedia("(pointer: fine)").matches,
    });
  };
  // The grid is atmosphere, not content: draw it after first paint.
  if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 800 });
  else setTimeout(start, 100);
</script>
