---
import PhoneHomeScreen from "./PhoneHomeScreen.astro";
import PhoneAppScreen from "./PhoneAppScreen.astro";
import type { AppEntry } from "../../../types/app";

/**
 * Device frame. `stage` holds the home screen plus every app (the sticky desktop phone);
 * `single` shows one app (inline on small screens). Decorative: the chapter text carries the content.
 */
export interface PhoneMockupProps {
  apps: readonly AppEntry[];
  mode: "stage" | "single";
}
const { apps, mode } = Astro.props as PhoneMockupProps;
---

<div class:list={["phone", `phone--${mode}`]} aria-hidden="true" data-phone={mode}>
  <div class="phone__screen" data-phone-screen>
    {mode === "stage" && <PhoneHomeScreen apps={apps} />}
    {apps.map((app) => (
      <PhoneAppScreen app={app} />
    ))}
    <span class="phone__island"></span>
    <span class="phone__indicator"></span>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: var(--phone-w, 18.5rem);
    aspect-ratio: 9 / 19.5;
    padding: 0.55rem;
    border-radius: var(--radius-phone);
    background: #02070b;
    box-shadow:
      inset 0 0 0 1px var(--color-line-strong),
      0 40px 80px -40px rgb(0 0 0 / 0.9);
  }
  .phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--radius-phone) - 0.55rem);
    background: var(--color-bg);
    isolation: isolate;
  }
  .phone__island {
    position: absolute;
    z-index: 5;
    top: 0.6rem;
    left: 50%;
    width: 30%;
    height: 1.6rem;
    translate: -50% 0;
    border-radius: 1rem;
    background: #000207;
  }
  .phone__indicator {
    position: absolute;
    z-index: 5;
    bottom: 0.4rem;
    left: 50%;
    width: 35%;
    height: 0.28rem;
    translate: -50% 0;
    border-radius: 1rem;
    background: var(--color-text);
    opacity: 0.7;
  }
  .phone--stage :global([data-app-screen]) {
    visibility: hidden;
    opacity: 0;
  }
</style>
