---
import AppIcon from "../../../components/ui/AppIcon.astro";
import AppLink from "../../../components/ui/AppLink.astro";
import AppIconGlyph from "../../../components/ui/AppIconGlyph.astro";
import PhoneMockup from "./PhoneMockup.astro";
import type { AppEntry } from "../../../types/app";

/** One project, one screen of breathing room. Holds all the real content for that app. */
export interface ProjectChapterProps {
  app: AppEntry;
}
const { app } = Astro.props as ProjectChapterProps;
const { data } = app;
const meta = [data.role, data.organization, data.market].filter(Boolean).join(" · ");
---

<article id={`app-${app.id}`} class="chapter" aria-labelledby={`app-${app.id}-name`} data-chapter={app.id}>
  <div class="chapter__phone">
    <PhoneMockup apps={[app]} mode="single" />
  </div>
  <div class="chapter__body">
    <div class="chapter__meta" data-chapter-item>
      <AppIcon monogram={data.icon.monogram} image={data.icon.image} tint={data.icon.tint} ink={data.icon.ink} size="md" />
      <p class="text-sm text-text-muted">{meta}</p>
      {data.status === "in-development" && <span class="wip">In development</span>}
    </div>
    <div class="chapter__title">
      <h3 id={`app-${app.id}-name`} class="font-display text-chapter font-bold tracking-display" data-chapter-title>
        {data.name}
      </h3>
      {data.tagline && (
        <p class="chapter__tagline" data-chapter-item>
          {data.tagline}
        </p>
      )}
    </div>
    {data.alternateName && (
      <p class="-mt-4 text-text-muted" data-chapter-item lang={data.alternateNameLang}>
        {data.alternateName}
      </p>
    )}
    <p class="max-w-measure font-display text-2xl leading-snug" data-chapter-item>
      {data.summary}
    </p>

    {data.metrics.length > 0 && (
      <dl class="flex flex-wrap gap-x-12 gap-y-4" data-chapter-item>
        {data.metrics.map((m) => (
          <div class="flex flex-col-reverse">
            <dt class="text-sm text-text-muted">{m.label}</dt>
            <dd class="font-display text-5xl font-bold tabular-nums">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <ul class="contrib" data-chapter-item>
      {data.contributions.map((c) => (
        <li>{c}</li>
      ))}
    </ul>

    {data.stack.length > 0 && (
      <ul class="flex list-none flex-wrap gap-2 p-0" aria-label="Technologies" data-chapter-item>
        {data.stack.map((s) => (
          <li class="chip">{s}</li>
        ))}
      </ul>
    )}

    <div data-chapter-item>
      {data.storeUrl ? (
        <AppLink href={data.storeUrl} external tone="accent" ariaLabel={`View ${data.name} on the App Store`}>
          View on the App Store <AppIconGlyph name="external" />
        </AppLink>
      ) : (
        <p class="text-sm text-text-muted">{data.statusNote}</p>
      )}
    </div>
  </div>
</article>

<style>
  .wip {
    padding: 0.2rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line-steel);
    color: var(--color-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  /* Phones: compact chapters separated by a rule. Desktop: one screen each. */
  .chapter {
    display: grid;
    gap: 2.25rem;
    padding: 4rem 0;
    border-top: 1px solid var(--color-line);
  }
  .chapter__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
  }
  .chapter__tagline {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-line-strong);
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
  }
  @media (max-width: 640px) {
    .chapter__tagline {
      flex-basis: 100%;
      padding-left: 0;
      border-left: 0;
    }
  }
  .chapter__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .chapter__meta p {
    flex: 0 1 auto;
    min-width: 0;
    max-width: calc(100% - 4.5rem);
  }
  .chapter__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .chapter__phone {
    display: grid;
    justify-items: center;
    --phone-w: min(11.5rem, 50vw);
  }
  .contrib {
    display: grid;
    gap: 0.6rem;
    max-width: var(--container-detail);
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
  }
  .contrib li::marker {
    color: var(--color-secondary);
  }
  .chip {
    padding: 0.3rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--color-line-steel);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  @media (min-width: 1024px) {
    .chapter {
      min-height: 100svh;
      align-content: center;
      border-top: 0;
    }
    .chapter__phone {
      display: none;
    }
  }
</style>
