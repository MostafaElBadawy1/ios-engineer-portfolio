---
import AppIcon from "../../../components/ui/AppIcon.astro";
import AppIconGlyph from "../../../components/ui/AppIconGlyph.astro";
import type { AppEntry } from "../../../types/app";

/** The springboard every story starts from: the six apps and a contact dock. */
export interface PhoneHomeScreenProps {
  apps: readonly AppEntry[];
}
const { apps } = Astro.props as PhoneHomeScreenProps;
const dock = ["mail", "github", "linkedin", "file"] as const;
---

<div class="home" data-home>
  <span class="home__status">9:41</span>
  <p class="home__widget">
    <span>Cairo</span>
    <span>iOS Engineer</span>
  </p>
  <ul class="home__grid">
    {apps.map((app) => (
      <li class="home__app" data-home-icon={app.id}>
        <AppIcon monogram={app.data.icon.monogram} tint={app.data.icon.tint} ink={app.data.icon.ink} size="sm" />
        <span>{app.data.name.split(" ")[0]}</span>
      </li>
    ))}
  </ul>
  <div class="home__dock">
    {dock.map((glyph) => (
      <span class="home__dock-icon squircle">
        <AppIconGlyph name={glyph} />
      </span>
    ))}
  </div>
</div>

<style>
  .home {
    position: absolute;
    inset: 0;
    padding: 3.3rem 1rem 0;
    background:
      radial-gradient(90% 60% at 20% 0%, rgb(102 155 188 / 0.22), transparent 70%),
      radial-gradient(80% 50% at 90% 100%, rgb(120 0 0 / 0.35), transparent 70%), var(--color-surface);
    will-change: transform, opacity;
  }
  .home__status {
    position: absolute;
    top: 0.95rem;
    left: 1.6rem;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .home__widget {
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 0.9rem;
    margin-bottom: 1.1rem;
    border-radius: 1.1rem;
    background: rgb(3 10 16 / 0.55);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .home__widget span + span {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .home__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .home__app {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    font-size: 0.62rem;
  }
  .home__dock {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.9rem;
    display: flex;
    justify-content: space-around;
    padding: 0.7rem 0.4rem;
    border-radius: 1.7rem;
    background: rgb(3 10 16 / 0.6);
  }
  .home__dock-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
  }
</style>
